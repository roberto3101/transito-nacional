---
import Base from '../layouts/Base.astro';
import { useDict } from '../lib/i18n';

const d = useDict('es');
---

<Base lang="es" title={d.meta.notFound.title} description={d.meta.notFound.description} esPath="/404" enPath="/404" noindex>
  <section class="section nf">
    <div class="container">
      <p class="mono nf-code">404</p>
      <h1 class="display">{d.notFound.title}</h1>
      <p class="lead">{d.notFound.text}</p>
      <a href="/" class="btn btn-primary">{d.notFound.back}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .nf-code {
    color: var(--brand-text);
    font-size: 1rem;
    letter-spacing: 0.3em;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    margin-top: 0.8rem;
  }

  .lead {
    margin-top: 1.2rem;
  }

  .btn {
    margin-top: 2rem;
  }
</style>
