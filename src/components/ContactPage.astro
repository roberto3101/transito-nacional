---
import Base from '../layouts/Base.astro';
import { useDict, whatsappHref, type Lang } from '../lib/i18n';
import { graph, orgNode, websiteNode, breadcrumbNode, SITE } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = useDict(lang);
const f = d.contact.form;
const esPath = '/contacto';
const enPath = '/en/contact';
const here = lang === 'es' ? esPath : enPath;

const jsonLd = graph(
  orgNode(d),
  websiteNode(d, lang),
  breadcrumbNode([
    { name: d.a11y.breadcrumbHome, url: `${SITE}${lang === 'es' ? '/' : '/en'}` },
    { name: d.nav.contact, url: `${SITE}${here}` },
  ])
);
---

<Base lang={lang} title={d.meta.contact.title} description={d.meta.contact.description} esPath={esPath} enPath={enPath} jsonLd={jsonLd}>
  <section class="section">
    <div class="container contact-grid">
      <header>
        <h1 class="h2 reveal">{d.contact.h1}</h1>
        <p class="lead reveal" style="--reveal-delay:.08s">{d.contact.lead}</p>

        <div class="direct reveal" style="--reveal-delay:.14s">
          <h2 class="mono direct-title">{d.contact.directTitle}</h2>
          <ul>
            <li>
              <span class="direct-label">{d.contact.phoneLabel}</span>
              <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="mono direct-value">{d.brand.phone}</a>
            </li>
            <li>
              <span class="direct-label">{d.contact.emailLabel}</span>
              <a href={`mailto:${d.brand.email}`} class="direct-value">{d.brand.email}</a>
            </li>
            <li>
              <span class="direct-label">{d.contact.hoursLabel}</span>
              <span class="direct-value">{d.contact.hoursValue}</span>
            </li>
          </ul>
        </div>
      </header>

      <form id="quote-form" class="reveal" style="--reveal-delay:.1s" data-wa={d.brand.whatsapp}>
        <div class="row">
          <div class="field">
            <label for="q-name">{f.name}</label>
            <input id="q-name" name="name" type="text" placeholder={f.namePh} required autocomplete="name" />
          </div>
          <div class="field">
            <label for="q-company">{f.company}</label>
            <input id="q-company" name="company" type="text" placeholder={f.companyPh} autocomplete="organization" />
          </div>
        </div>

        <div class="row">
          <div class="field">
            <label for="q-origin">{f.origin}</label>
            <input id="q-origin" name="origin" type="text" placeholder={f.originPh} required />
          </div>
          <div class="field">
            <label for="q-dest">{f.destination}</label>
            <input id="q-dest" name="destination" type="text" placeholder={f.destinationPh} required />
          </div>
        </div>

        <div class="row">
          <div class="field">
            <label for="q-type">{f.cargoType}</label>
            <input id="q-type" name="cargoType" type="text" placeholder={f.cargoTypePh} required />
          </div>
          <div class="field">
            <label for="q-weight">{f.weight}</label>
            <input id="q-weight" name="weight" type="text" placeholder={f.weightPh} />
          </div>
        </div>

        <div class="field">
          <label for="q-msg">{f.message}</label>
          <textarea id="q-msg" name="message" rows="4" placeholder={f.messagePh}></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{f.submit}</button>
        <p class="hint">{f.hint}</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  h1 {
    max-width: 12ch;
  }

  .lead {
    margin-top: 1.1rem;
  }

  .direct {
    margin-top: 2.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 1.6rem;
    background: var(--surface);
  }

  .direct-title {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .direct ul {
    margin-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .direct li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .direct-label {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .direct-value {
    font-weight: 600;
    font-size: 1.05rem;
  }

  a.direct-value:hover {
    color: var(--brand);
  }

  form {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: clamp(1.5rem, 3.5vw, 2.4rem);
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.3rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  label {
    font-weight: 600;
    font-size: 0.92rem;
  }

  input,
  textarea {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    padding: 0.8rem 0.95rem;
    transition: border-color 0.2s ease;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--muted);
    opacity: 0.75;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 0;
    border-color: var(--brand);
  }

  textarea {
    resize: vertical;
  }

  button {
    align-self: flex-start;
  }

  .hint {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }

    button {
      align-self: stretch;
    }
  }
</style>

<script>
  // El formulario arma el mensaje y abre WhatsApp: cero backend, cero espera.
  // Delegado en document para sobrevivir a las View Transitions.
  document.addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest('#quote-form') as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();
    const data = new FormData(form);
    const es = document.documentElement.lang.startsWith('es');
    const L = es
      ? { hi: 'Hola, quiero cotizar un transporte de carga.', name: 'Nombre', company: 'Empresa', origin: 'Origen', dest: 'Destino', type: 'Tipo de carga', weight: 'Peso aprox.', msg: 'Detalles' }
      : { hi: 'Hello, I would like a freight quote.', name: 'Name', company: 'Company', origin: 'Origin', dest: 'Destination', type: 'Cargo type', weight: 'Approx. weight', msg: 'Details' };

    const lines = [
      L.hi,
      `${L.name}: ${data.get('name')}`,
      data.get('company') ? `${L.company}: ${data.get('company')}` : '',
      `${L.origin}: ${data.get('origin')}`,
      `${L.dest}: ${data.get('destination')}`,
      `${L.type}: ${data.get('cargoType')}`,
      data.get('weight') ? `${L.weight}: ${data.get('weight')}` : '',
      data.get('message') ? `${L.msg}: ${data.get('message')}` : '',
    ].filter(Boolean);

    const wa = form.dataset.wa;
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>
