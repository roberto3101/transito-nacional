---
/**
 * Logo de Tránsito Nacional, recreado en limpio a partir del logo original:
 * pin de ubicación (el punto naranja es la marca) + wordmark en Archivo Black.
 * variant "lockup"  → pin + TRÁNSITO / NACIONAL (header y footer)
 * variant "mark"    → solo el pin (favicons, espacios reducidos)
 */
interface Props {
  variant?: 'lockup' | 'mark';
  class?: string;
}
const { variant = 'lockup', class: className } = Astro.props;
---

{
  variant === 'mark' ? (
    <svg
      class={className}
      viewBox="0 0 48 60"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M24 2C12.4 2 3 11.4 3 23c0 8.7 5 16 11.9 22.7L24 58l9.1-12.3C40 39 45 31.7 45 23 45 11.4 35.6 2 24 2Z"
        fill="currentColor"
      />
      <circle cx="24" cy="22.5" r="8.5" fill="var(--brand)" />
    </svg>
  ) : (
    <span class:list={['logo-lockup', className]}>
      <svg viewBox="0 0 48 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          d="M24 2C12.4 2 3 11.4 3 23c0 8.7 5 16 11.9 22.7L24 58l9.1-12.3C40 39 45 31.7 45 23 45 11.4 35.6 2 24 2Z"
          fill="currentColor"
        />
        <circle cx="24" cy="22.5" r="8.5" fill="var(--brand)" />
      </svg>
      <span class="logo-text">
        <span class="logo-main">Tránsito</span>
        <span class="logo-sub">Nacional</span>
      </span>
    </span>
  )
}

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
  }

  svg {
    height: 2.35rem;
    width: auto;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-main {
    font-family: var(--font-display);
    font-size: 1.22rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--brand);
  }

  .logo-sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--text);
    margin-top: 0.28rem;
  }
</style>
