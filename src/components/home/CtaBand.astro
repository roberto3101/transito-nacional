---
import Picture from '../Picture.astro';
import { useDict, whatsappHref, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = useDict(lang);
const kmLabel = lang === 'es' ? 'DESTINO' : 'DESTINATION';
const imgAlt =
  lang === 'es'
    ? 'Carretera andina al atardecer, final del recorrido'
    : 'Andean highway at dusk, end of the journey';
---

<section class="cta-section" aria-labelledby="cta-title">
  <!-- La ruta termina en fotografía real: el destino existe, no es un rectángulo -->
  <div class="cta-media" aria-hidden="true">
    <Picture name="hero-andes" alt={imgAlt} sizes="100vw" width={1920} height={1088} />
  </div>
  <div class="cta-scrim" aria-hidden="true"></div>

  <div class="container cta-inner">
    <div class="cta-panel reveal">
      <!-- Hito kilométrico: marcador de carretera, no una píldora -->
      <div class="km-marker" aria-hidden="true">
        <span class="km-num mono">3190</span>
        <span class="km-unit mono">KM · {kmLabel}</span>
      </div>

      <div class="cta-copy">
        <h2 id="cta-title" class="display">{d.cta.title}</h2>
        <p>{d.cta.text}</p>
        <div class="cta-actions">
          <a href={whatsappHref(lang)} class="btn cta-btn btn-shine" target="_blank" rel="noopener">
            {d.cta.button}
          </a>
          <span class="cta-or">
            {d.cta.or} <a href={`mailto:${d.brand.email}`} class="cta-mail">{d.brand.email}</a>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: var(--section);
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 62svh, 44rem);
    background: #14100c;
  }

  .cta-media,
  .cta-media :global(picture),
  .cta-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-media :global(img) {
    object-position: 50% 42%;
  }

  /* Degradado que empuja la luz hacia la derecha y deja respirar el panel */
  .cta-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(96deg, rgba(14, 10, 6, 0.94) 0%, rgba(14, 10, 6, 0.72) 42%, rgba(14, 10, 6, 0.15) 72%, rgba(14, 10, 6, 0.45) 100%),
      linear-gradient(0deg, rgba(14, 10, 6, 0.55) 0%, transparent 40%);
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  /* Panel angular: el corte diagonal cita el extremo de una faja de amarre */
  .cta-panel {
    position: relative;
    display: flex;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    max-width: 46rem;
    padding: clamp(1.9rem, 3.6vw, 2.9rem) clamp(3.5rem, 6vw, 5rem) clamp(1.9rem, 3.6vw, 2.9rem) clamp(1.6rem, 3vw, 2.4rem);
    background: linear-gradient(118deg, var(--brand-strong) 0%, var(--brand) 62%, #ff9c3f 100%);
    color: var(--brand-ink);
    clip-path: polygon(0 0, 100% 0, calc(100% - 2.6rem) 100%, 0 100%);
    box-shadow: 0 34px 80px -34px rgba(0, 0, 0, 0.9);
  }

  /* Marcador de kilómetro vertical, como los hitos de carretera */
  .km-marker {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-right: clamp(1.2rem, 2.4vw, 1.8rem);
    border-right: 1px solid rgba(29, 19, 10, 0.28);
  }

  .km-num {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .km-unit {
    font-size: 0.58rem;
    letter-spacing: 0.24em;
    writing-mode: vertical-rl;
    opacity: 0.72;
  }

  .cta-copy {
    min-width: 0;
  }

  h2 {
    font-size: clamp(2.1rem, 4.6vw, 3.7rem);
    line-height: 0.92;
    max-width: 13ch;
  }

  p {
    margin-top: 1.1rem;
    max-width: 40ch;
    font-weight: 500;
    color: rgba(29, 19, 10, 0.85);
  }

  .cta-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .cta-btn {
    background: var(--brand-ink);
    color: #fff;
    padding: 1rem 1.8rem;
    box-shadow: 0 12px 30px -10px rgba(29, 19, 10, 0.6);
  }

  .cta-btn:hover {
    background: #000;
  }

  .cta-or {
    font-size: 0.93rem;
  }

  .cta-mail {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .cta-panel {
      flex-direction: column;
      padding: 1.8rem 1.5rem 2rem;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.8rem), calc(100% - 1.8rem) 100%, 0 100%);
    }

    .km-marker {
      flex-direction: row;
      align-items: baseline;
      gap: 0.6rem;
      padding-right: 0;
      padding-bottom: 0.9rem;
      border-right: 0;
      border-bottom: 1px solid rgba(29, 19, 10, 0.28);
    }

    .km-unit {
      writing-mode: horizontal-tb;
    }

    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
