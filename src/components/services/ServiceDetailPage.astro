---
import Base from '../../layouts/Base.astro';
import Picture from '../Picture.astro';
import FaqSection from '../home/FaqSection.astro';
import CtaBand from '../home/CtaBand.astro';
import { useDict, altServiceSlug, whatsappHref, p, type Lang, type ServiceItem } from '../../lib/i18n';
import { graph, orgNode, websiteNode, serviceNode, breadcrumbNode, faqNode, SITE } from '../../lib/seo';

interface Props {
  lang: Lang;
  service: ServiceItem;
}
const { lang, service: s } = Astro.props;
const d = useDict(lang);

const esPath = lang === 'es' ? `/servicios/${s.slug}` : `/servicios/${altServiceSlug(s, lang)}`;
const enPath = lang === 'en' ? `/en/services/${s.slug}` : `/en/services/${altServiceSlug(s, lang)}`;
const here = lang === 'es' ? esPath : enPath;
const svcIndex = lang === 'es' ? '/servicios' : '/en/services';

const jsonLd = graph(
  orgNode(d),
  websiteNode(d, lang),
  serviceNode({ name: s.name, description: s.meta.description, url: `${SITE}${here}` }),
  breadcrumbNode([
    { name: d.a11y.breadcrumbHome, url: `${SITE}${lang === 'es' ? '/' : '/en'}` },
    { name: d.nav.services, url: `${SITE}${svcIndex}` },
    { name: s.name, url: `${SITE}${here}` },
  ]),
  faqNode(s.faq)
);

const waMsg =
  lang === 'es'
    ? `Hola, quiero cotizar: ${s.name}.`
    : `Hello, I would like a quote for: ${s.name}.`;
---

<Base lang={lang} title={s.meta.title} description={s.meta.description} esPath={esPath} enPath={enPath} jsonLd={jsonLd}>
  <article>
    <header class="section svc-hero">
      <div class="container">
        <nav class="crumbs mono" aria-label="breadcrumb">
          <a href={p(lang, '/') || '/'}>{d.a11y.breadcrumbHome}</a>
          <span aria-hidden="true">/</span>
          <a href={svcIndex}>{d.nav.services}</a>
        </nav>
        <h1 class="h2 reveal">{s.h1}</h1>
        <p class="lead reveal" style="--reveal-delay:.08s">{s.lead}</p>
        <div class="svc-cta reveal" style="--reveal-delay:.14s">
          <a href={whatsappHref(lang, waMsg)} class="btn btn-primary" target="_blank" rel="noopener">{d.nav.quote}</a>
        </div>
      </div>
    </header>

    <div class="container">
      <figure class="media-card svc-cover reveal">
        <Picture name={s.image} alt={s.imageAlt} sizes="(max-width: 1240px) 100vw, 1180px" loading="eager" fetchpriority="high" />
      </figure>
    </div>

    <section class="section svc-body">
      <div class="container body-grid">
        <div>
          <h2 class="h3 includes-title">{s.includesTitle}</h2>
          <ul class="includes">
            {s.includes.map((it) => (
              <li>
                <svg viewBox="0 0 256 256" width="18" height="18" fill="var(--brand)" aria-hidden="true"><path d="m229.66 77.66-128 128a8 8 0 0 1-11.32 0l-56-56a8 8 0 0 1 11.32-11.32L96 188.69 218.34 66.34a8 8 0 0 1 11.32 11.32Z"/></svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="svc-text">
          {s.body.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </div>
    </section>

    <FaqSection lang={lang} items={s.faq} />
    <CtaBand lang={lang} />
  </article>
</Base>

<style>
  .svc-hero {
    padding-bottom: 2.5rem;
  }

  .crumbs {
    display: flex;
    gap: 0.7rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.6rem;
  }

  .crumbs a:hover {
    color: var(--brand);
  }

  h1 {
    max-width: 16ch;
  }

  .lead {
    margin-top: 1.1rem;
  }

  .svc-cta {
    margin-top: 1.8rem;
  }

  .svc-cover {
    aspect-ratio: 21 / 9;
    box-shadow: var(--shadow-card);
  }

  .svc-cover :global(img) {
    height: 100%;
  }

  .svc-body {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .body-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .includes-title {
    margin-bottom: 1.4rem;
  }

  .includes {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .includes li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-weight: 500;
  }

  .includes svg {
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .svc-text {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .body-grid {
      grid-template-columns: 1fr;
    }

    .svc-cover {
      aspect-ratio: 16 / 10;
    }
  }
</style>
